generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  employee      Employee?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                String                  @id
  name              String
  slug              String
  logo              String?
  createdAt         DateTime
  metadata          String?
  members           Member[]
  invitations       Invitation[]
  employees         Employee[]
  leaveTypes        LeaveType[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  holidays          Holiday[]
  attendance        AttendanceRecord[]
  regularizations   RegularizationRequest[]
  employeeDocuments EmployeeDocument[]
  departments       Department[]
  expenseTypes      ExpenseType[]
  expenseRequests   ExpenseRequest[]
  salaryComponents  SalaryComponent[]
  salaryStructures  SalaryStructure[]
  payrollSettings   PayrollSettings?
  payrollRuns       PayrollRun[]
  taxDeclarations   EmployeeTaxDeclaration[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum EmployeeRole {
  ADMIN
  EMPLOYEE
}

// Per-org, configurable like LeaveType. isActive lets HR retire a department
// without breaking history for employees already assigned to it.
model Department {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Per-org, admin-configurable expense categories (Travel, Meals, ...) — same
// shape and lifecycle as Department: seeded with defaults on registration,
// renameable/retireable (isActive) rather than freely deletable once
// referenced (see the ExpenseRequest count guard in expenseTypes.routes.ts).
model ExpenseType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseRequests ExpenseRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Employee {
  id             String  @id @default(cuid())
  userId         String? @unique
  organizationId String

  fullName    String
  email       String
  designation String?
  role        EmployeeRole @default(EMPLOYEE)
  invitedAt   DateTime?
  // The active/inactive switch — deliberately not a delete. An inactive
  // employee keeps every historical record (leave, attendance, documents)
  // but is locked out of the portal (see resolveAuth in
  // src/core/plugins/authGuard.ts) and stops accruing leave (see
  // accrueForOrg in src/modules/leave/accrual.ts).
  isActive    Boolean      @default(true)
  // Used for leave-accrual eligibility: an employee doesn't accrue for months
  // before they joined. Nullable — null is treated as "always eligible" (e.g.
  // existing employees created before this field existed).
  joiningDate DateTime?
  // Record-keeping only — set when an employee exits. Nothing currently
  // branches on this (no automatic deactivation, no accrual/attendance
  // cutoff); it's purely so HR has a place to record and see the date.
  leavingDate DateTime?

  departmentId String?

  // Optional HR profile fields — all nullable, filled in over time rather
  // than required at creation.
  employeeCode          String?
  phone                 String?
  dateOfBirth           DateTime? @db.Date
  gender                String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  managerId String?
  manager   Employee?  @relation("Reports", fields: [managerId], references: [id])
  reports   Employee[] @relation("Reports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SetNull (not Cascade): the Employee is an HR record independent of portal
  // login — deleting the linked User account should just revoke login, not
  // erase the HR artifact.
  user                            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization                    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department                      Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaveBalances                   LeaveBalance[]
  leaveRequests                   LeaveRequest[]          @relation("LeaveRequestsByEmployee")
  decidedLeaveRequests            LeaveRequest[]          @relation("LeaveRequestsDecidedBy")
  attendance                      AttendanceRecord[]
  regularizations                 RegularizationRequest[] @relation("RegularizationsByEmployee")
  decidedRegularizations          RegularizationRequest[] @relation("RegularizationsDecidedBy")
  documents                       EmployeeDocument[]      @relation("EmployeeDocumentsOwned")
  uploadedDocuments               EmployeeDocument[]      @relation("EmployeeDocumentsUploadedBy")
  expenseRequests                 ExpenseRequest[]        @relation("ExpenseRequestsByEmployee")
  approverExpenseRequests         ExpenseRequest[]        @relation("ExpenseRequestsByApproverManager")
  adminDecidedExpenseRequests     ExpenseRequest[]        @relation("ExpenseRequestsAdminDecidedBy")
  paymentInitiatedExpenseRequests ExpenseRequest[]        @relation("ExpenseRequestsPaymentInitiatedBy")
  uploadedExpenseAttachments      ExpenseAttachment[]     @relation("ExpenseAttachmentsUploadedBy")
  salaryStructures                SalaryStructure[]
  payslips                        Payslip[]
  taxDeclarations                 EmployeeTaxDeclaration[]
  approvedPayrollRuns             PayrollRun[]            @relation("PayrollRunApprovedBy")

  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([managerId])
  @@index([departmentId])
}

enum EmployeeDocumentType {
  GOV_ID
  HIGHER_SECONDARY_MARKSHEET
  GRADUATION_CERTIFICATE
  PG_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  RELIEVING_LETTER
}

// One row per uploaded file. storagePath is a generated on-disk filename
// (uuid + original extension) under DOCUMENT_UPLOAD_DIR (see
// src/modules/employees/employeeDocuments.routes.ts) — never the
// caller-supplied name, so a crafted fileName can't traverse or collide on
// disk. fileName keeps the original name for display/download.
model EmployeeDocument {
  id             String               @id @default(cuid())
  organizationId String
  employeeId     String
  type           EmployeeDocumentType
  fileName       String
  storagePath    String
  mimeType       String
  fileSize       Int
  uploadedById   String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("EmployeeDocumentsOwned", fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy   Employee     @relation("EmployeeDocumentsUploadedBy", fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([employeeId])
}

// MONTHLY_ACCRUAL (CL/SL/EL and any custom type): accrualPerMonth is credited
// each month up to annualCap, via accrueForOrg (src/modules/leave/accrual.ts).
// ANNUAL_GRANT (the floater type): the full annualGrantDays is set on the
// employee's balance once a year, via grantAnnualForOrg
// (src/modules/leave/floaterGrant.ts) — accrueForOrg explicitly skips these.
// accrualPerMonth/annualCap are unused for ANNUAL_GRANT types but stay
// required for schema simplicity; they're set to 0/annualGrantDays and never
// read on that path.
enum LeaveAllocationType {
  MONTHLY_ACCRUAL
  ANNUAL_GRANT
}

// One row per (org, leave code) — e.g. CL/SL/EL.
model LeaveType {
  id              String              @id @default(cuid())
  organizationId  String
  name            String
  code            String
  accrualPerMonth Decimal             @db.Decimal(5, 2)
  annualCap       Int
  isPaid          Boolean             @default(true)
  allowHalfDay    Boolean             @default(true)
  isActive        Boolean             @default(true)
  allocationType  LeaveAllocationType @default(MONTHLY_ACCRUAL)
  // Only meaningful when allocationType is ANNUAL_GRANT — the flat number of
  // days granted per employee per year (see grantAnnualForOrg).
  annualGrantDays Decimal?            @db.Decimal(6, 2)
  // When true, submitLeaveRequest (leaveRequests.service.ts) requires every
  // request against this type to be a single day that is one of the org's
  // Holiday.isOptional dates — see the Holiday comment below. Nothing enforces
  // "at most one per org" at the schema level; that's a product choice this
  // model doesn't need to make.
  isFloater       Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// One row per (employee, leave type, year). Available balance is computed
// (accruedDays - usedDays), not stored. lastAccruedMonth records the last
// calendar month (1-12) accrueForOrg applied for this year, so re-running a
// month is a no-op and a missed month can be applied later.
model LeaveBalance {
  id               String  @id @default(cuid())
  organizationId   String
  employeeId       String
  leaveTypeId      String
  year             Int
  accruedDays      Decimal @default(0) @db.Decimal(6, 2)
  usedDays         Decimal @default(0) @db.Decimal(6, 2)
  lastAccruedMonth Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// One row per submitted leave request. workingDays is computed by
// countWorkingDays (src/shared/workingDays.ts) at submission time and stored —
// it's the amount reserved against the balance while PENDING, and the amount
// deducted (LeaveBalance.usedDays) on APPROVED. REJECTED/CANCELLED never
// touch usedDays, since a pending request was only ever reserved, not
// deducted (see src/modules/leave/balances.ts).
model LeaveRequest {
  id             String @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String

  // @db.Date: calendar dates, no time-of-day/timezone — see the UTC-only
  // handling note in src/shared/workingDays.ts.
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  isHalfDay   Boolean  @default(false)
  reason      String?
  workingDays Decimal  @db.Decimal(6, 2)

  status              LeaveStatus @default(PENDING)
  decidedByEmployeeId String?
  decidedAt           DateTime?
  decisionNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("LeaveRequestsByEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  decidedBy    Employee?    @relation("LeaveRequestsDecidedBy", fields: [decidedByEmployeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
}

// A company holiday for one org.
//
// isOptional=false (the default) is a closure day: the whole org is off,
// excluded from working-day/attendance calculations for everyone — see
// getHolidayDateKeys and loadAttendanceContext.
//
// isOptional=true stays a normal WORKING day for anyone who doesn't take it —
// it is deliberately NOT excluded by getHolidayDateKeys. An employee "takes"
// one by submitting an ordinary LeaveRequest against the org's isFloater
// LeaveType; submitLeaveRequest requires that request's single date to be one
// of these. That reuses the whole leave balance/approval system instead of a
// second one, so no floater-specific request/limit logic exists anywhere
// else in this module.
model Holiday {
  id             String @id @default(cuid())
  organizationId String

  // @db.Date for the same reason as LeaveRequest.startDate: a holiday is a
  // calendar date, not an instant. `year` is derived from `date` at write
  // time (there's no computed-column support here) purely so the common
  // "the org's calendar for 2026" query is a plain indexed lookup.
  date       DateTime @db.Date
  name       String
  year       Int
  isOptional Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, year])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum AttendanceSource {
  SELF
  HR_MARKED
  SYSTEM
  // Written by an APPROVED RegularizationRequest. Distinct from HR_MARKED so
  // the audit trail separates "HR edited this directly" from "the employee
  // asked and an approver agreed" — both are explicit human decisions and
  // both win over recomputing status from clock times (see
  // isExplicitHumanDecision in src/modules/attendance/derivation.ts).
  REGULARIZED
}

// One row per (employee, day) — only for days something was actually
// recorded. Days with no row still get a status (WEEK_OFF/HOLIDAY/ON_LEAVE/
// ABSENT) from deriveDailyStatus (src/modules/attendance/derivation.ts); the table is
// deliberately sparse rather than pre-seeding a row per employee per day.
model AttendanceRecord {
  id             String @id @default(cuid())
  organizationId String
  employeeId     String

  // @db.Date, UTC calendar day — same convention as LeaveRequest.startDate
  // and Holiday.date. checkInAt/checkOutAt are full instants (timestamps).
  date          DateTime  @db.Date
  checkInAt     DateTime?
  checkOutAt    DateTime?
  // Derived at check-out from checkOutAt - checkInAt; null while the day is
  // still open (checked in, not yet out).
  workedMinutes Int?

  status AttendanceStatus
  source AttendanceSource
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RegularizationType {
  MISSING_PUNCH
  WRONG_TIME
  WFH
  OTHER
}

// An employee-initiated request to correct their own attendance for one day,
// approved by any MANAGER/HR/ADMIN. Approving applies the correction to the
// AttendanceRecord (source REGULARIZED); the request row itself is kept as
// the audit trail of who asked, who decided, and why.
//
// "At most one PENDING per (employeeId, date)" is enforced by a PARTIAL
// unique index — Prisma's @@unique can't express a WHERE clause, so it's
// hand-written in the migration:
//   CREATE UNIQUE INDEX "RegularizationRequest_one_pending_per_employee_date"
//     ON "RegularizationRequest"("employeeId", "date") WHERE status = 'PENDING';
// A plain @@unique would wrongly block re-requesting after a rejection, and
// an app-level check alone races under concurrent submits.
model RegularizationRequest {
  id             String @id @default(cuid())
  organizationId String
  employeeId     String

  // @db.Date, UTC calendar day — same convention as AttendanceRecord.date.
  date DateTime           @db.Date
  type RegularizationType

  // What the employee is asking for. At least one must be present (enforced
  // by zod at the route); null means "leave that field as it is".
  requestedCheckInAt  DateTime?
  requestedCheckOutAt DateTime?
  requestedStatus     AttendanceStatus?
  reason              String

  status              RegularizationStatus @default(PENDING)
  decidedByEmployeeId String?
  decidedAt           DateTime?
  decisionNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("RegularizationsByEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy    Employee?    @relation("RegularizationsDecidedBy", fields: [decidedByEmployeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
}

// GLOBAL reference data — deliberately NO organizationId. An exchange rate
// (e.g. "1 USD = X INR" on a given ECB date) is not tenant-owned: every org
// converts against the same rate for the same day, sourced from Frankfurter
// (api.frankfurter.dev), which republishes ECB rates. This is an intentional
// exception to the "every mutation must be tenant-scoped" rule in CLAUDE.md —
// there is nothing to scope, the data itself has no owner.
//
// One row per (currency, rateDate); "the latest rate for a currency" is a
// findFirst ordered by rateDate desc, which the @@unique index below serves
// directly. See src/modules/currency/exchangeRates.service.ts.
model ExchangeRate {
  id String @id @default(cuid())

  // The foreign ISO code (never "INR" — INR-to-INR is always 1 and isn't
  // stored). Not a Prisma enum: keeping it a plain string means adding a
  // supported currency (see SUPPORTED_CURRENCIES in
  // src/modules/currency/currencies.ts) never needs a migration.
  currency   String
  // INR per 1 unit of `currency`, e.g. 95.960000 for USD.
  inrPerUnit Decimal  @db.Decimal(12, 6)
  // The ECB rate date Frankfurter returned — @db.Date since it's a calendar
  // day, not an instant (same convention as Holiday.date elsewhere).
  rateDate   DateTime @db.Date
  fetchedAt  DateTime @default(now())

  @@unique([currency, rateDate])
}

// One status field is the source of truth for the whole lifecycle — never a
// pair of booleans (managerApproved/adminApproved), which can't represent
// "rejected at the manager stage" vs "rejected at the admin stage" without
// extra flags, and can drift out of sync under concurrent writes in a way a
// single enum column with a transactional re-check (see expenseRequests.service.ts)
// can't.
//
//   PENDING_MANAGER --(manager-approve)--> PENDING_ADMIN --(admin-approve)--> APPROVED --(initiate-payment)--> PAYMENT_INITIATED
//         |                                      |
//         +--(manager-reject)--> REJECTED <------+--(admin-reject)
//         |
//         +--(cancel, raiser only)--> CANCELLED
//
// REJECTED and CANCELLED are terminal from either stage; there is no path
// back to PENDING_* once left.
enum ExpenseStatus {
  PENDING_MANAGER
  PENDING_ADMIN
  APPROVED
  PAYMENT_INITIATED
  REJECTED
  CANCELLED
}

// An employee-raised expense reimbursement, routed through a two-stage
// approval chain: the raiser's chosen "reporting manager" (approverManagerId
// — not necessarily their actual Employee.managerId; see the "approver"
// definition in expenseRequests.routes.ts) decides first, then any ADMIN.
//
// amount/currency is what the employee entered; exchangeRate/amountInInr/
// rateDate are FROZEN at submission time via currency/exchangeRates.service.ts
// convertToInr() and never recomputed — approving a request later, or the
// daily rate refresh moving the cached rate, must never change what an
// already-submitted expense is worth in INR.
model ExpenseRequest {
  id                String @id @default(cuid())
  organizationId    String
  employeeId        String
  approverManagerId String
  expenseTypeId     String

  title       String
  description String?
  // When the expense was actually incurred — @db.Date, UTC calendar day, same
  // convention as LeaveRequest.startDate. Distinct from createdAt: a bill is
  // often filed days after the trip.
  expenseDate DateTime @db.Date
  // The employee-entered amount, in `currency` — not INR.
  amount      Decimal @db.Decimal(12, 2)
  currency    String

  // Frozen at creation (see the model comment above) — the rate this
  // specific request was priced at, independent of whatever refreshRates()
  // later stores in the global ExchangeRate cache for the same currency.
  exchangeRate Decimal  @db.Decimal(12, 6)
  amountInInr  Decimal  @db.Decimal(12, 2)
  rateDate     DateTime @db.Date

  status ExpenseStatus @default(PENDING_MANAGER)

  managerDecidedAt    DateTime?
  managerDecisionNote String?

  adminDecidedById  String?
  adminDecidedAt    DateTime?
  adminDecisionNote String?

  // Set by POST /expenses/:id/initiate-payment — the final step, currently
  // ADMIN-gated. See the TODO on that route for gating this on a "Finance"
  // department instead (or in addition), once Department carries that
  // meaning — no new role.
  paymentInitiatedById String?
  paymentInitiatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee            @relation("ExpenseRequestsByEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  approverManager    Employee            @relation("ExpenseRequestsByApproverManager", fields: [approverManagerId], references: [id])
  expenseType        ExpenseType         @relation(fields: [expenseTypeId], references: [id])
  adminDecidedBy     Employee?           @relation("ExpenseRequestsAdminDecidedBy", fields: [adminDecidedById], references: [id])
  paymentInitiatedBy Employee?           @relation("ExpenseRequestsPaymentInitiatedBy", fields: [paymentInitiatedById], references: [id])
  attachments        ExpenseAttachment[]

  @@index([organizationId])
  @@index([employeeId])
  @@index([approverManagerId])
  @@index([status])
}

// The bill(s) for one ExpenseRequest — multiple per request, same
// UUID-storage-path pattern as EmployeeDocument (storagePath is a generated
// filename, never the caller-supplied name, so it can't traverse or collide
// on disk). No organizationId of its own: it's only ever reached through its
// already tenant-scoped parent ExpenseRequest (every route looks the parent
// up by (id, organizationId) first), same as how RegularizationRequest's
// decidedBy is reached through the request rather than re-scoped itself.
model ExpenseAttachment {
  id               String @id @default(cuid())
  expenseRequestId String

  fileName     String
  storagePath  String
  mimeType     String
  fileSize     Int
  uploadedById String

  createdAt DateTime @default(now())

  expenseRequest ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  uploadedBy     Employee       @relation("ExpenseAttachmentsUploadedBy", fields: [uploadedById], references: [id])

  @@index([expenseRequestId])
}

enum ComponentType {
  EARNING
  EMPLOYEE_DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum CalcType {
  FIXED
  PERCENTAGE
  BALANCE
}

// The org-level rulebook — one row per salary component (Basic Pay, HRA, PF,
// ...). `code` is the per-org unique key. `sequence` is the computation
// order computeSalaryStructure (salaryComputation.ts) resolves in: FIXED
// first, then PERCENTAGE (which reads a baseComponent's already-resolved
// amount, so its sequence must exceed its base's), then BALANCE last, taking
// whatever's left of the CTC. Sequence uniqueness and the FIXED < PERCENTAGE
// < BALANCE ordering are business rules enforced in
// salaryComponents.service.ts (validateComponentOrdering) — deliberately not
// a DB constraint, since which sequence numbers are valid depends on every
// other active component in the org, not just this row.
model SalaryComponent {
  id              String        @id @default(cuid())
  organizationId  String
  name            String
  code            String
  componentType   ComponentType
  calcType        CalcType
  fixedAmount     Decimal?      @db.Decimal(12, 2)
  percentage      Decimal?      @db.Decimal(5, 2)
  baseComponentId String?
  sequence        Int
  isActive        Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization               @relation(fields: [organizationId], references: [id])
  baseComponent       SalaryComponent?           @relation("ComponentBase", fields: [baseComponentId], references: [id])
  derivedComponents   SalaryComponent[]          @relation("ComponentBase")
  structureComponents SalaryStructureComponent[]
  payslipComponents   PayslipComponent[]

  @@unique([organizationId, code])
  @@index([organizationId, sequence])
}

// One row per (employee, effective period) — a full history of every salary
// change, not just the current numbers. `effectiveTo: null` marks the single
// currently-active structure for an employee; creating a new one closes out
// the old one (sets its effectiveTo) in the same transaction — see
// createSalaryStructure in salaryStructures.service.ts.
model SalaryStructure {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  annualCtc      Decimal   @db.Decimal(12, 2)
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id])
  employee     Employee                   @relation(fields: [employeeId], references: [id])
  components   SalaryStructureComponent[]

  @@index([employeeId, effectiveFrom])
  @@index([organizationId])
}

// The resolved per-employee amounts for one SalaryStructure — the output of
// computeSalaryStructure, frozen onto the structure at creation time (same
// freeze-at-submission spirit as ExpenseRequest.amountInInr): a later change
// to the SalaryComponent rulebook (a percentage tweak, a new base) never
// retroactively changes a historical structure's numbers.
model SalaryStructureComponent {
  id            String  @id @default(cuid())
  structureId   String
  componentId   String
  monthlyAmount Decimal @db.Decimal(12, 2)
  annualAmount  Decimal @db.Decimal(12, 2)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@unique([structureId, componentId])
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  PAID
  CANCELLED
}

enum LopBasis {
  CALENDAR_DAYS
  WORKING_DAYS
}

enum TaxRegime {
  OLD
  NEW
}

// Org-level payroll config — one row per org, created lazily (upsert) on
// first GET rather than seeded at registration; see payrollSettings.service.ts.
model PayrollSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  pfEnabled      Boolean  @default(true)
  // true = cap the PF wage base at ₹15,000 basic; false = full basic.
  pfCeiling      Boolean  @default(true)
  esiEnabled     Boolean  @default(true)
  ptEnabled      Boolean  @default(true)
  // Drives the PT slab lookup in modules/payroll/ptSlabs.ts, e.g. "MAHARASHTRA".
  ptState        String?
  lopBasis       LopBasis @default(CALENDAR_DAYS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// One row per org per month. Status is the single source of truth for the
// lifecycle (same "one enum, never boolean pairs" reasoning as ExpenseStatus
// above):
//   DRAFT --(process)--> PROCESSING --(success)--> REVIEW --(approve)--> APPROVED --(pay)--> PAID
//     |                     |
//     +--(cancel)--> CANCELLED <--(cancel, from REVIEW)--+
// REVIEW can also loop back to PROCESSING via reprocess (payrollRuns.service.ts
// reuses the same processPayrollRun function). APPROVED and PAID are
// immutable — no reprocessing past APPROVED.
//
// Deliberately NOT @@unique([organizationId, month, year]): a CANCELLED run
// must not block creating a new one for the same month. Prisma's @@unique
// can't express a WHERE clause, so "at most one non-cancelled run per
// (org, month, year)" is a hand-written partial unique index in the
// migration — same technique as
// RegularizationRequest_one_pending_per_employee_date.
model PayrollRun {
  id                String           @id @default(cuid())
  organizationId    String
  month             Int
  year              Int
  status            PayrollRunStatus @default(DRAFT)
  totalGross        Decimal?         @db.Decimal(14, 2)
  totalDeductions   Decimal?         @db.Decimal(14, 2)
  totalNet          Decimal?         @db.Decimal(14, 2)
  totalEmployerCost Decimal?         @db.Decimal(14, 2)
  processedAt       DateTime?
  approvedAt        DateTime?
  // The approving admin's Employee.id (not User.id) — consistent with
  // ExpenseRequest.adminDecidedById elsewhere in this schema.
  approvedById      String?
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  approvedBy   Employee?    @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id])
  payslips     Payslip[]

  @@index([organizationId, month, year])
  @@index([organizationId, status])
}

// One row per employee per run — the output of engine.ts's computePayroll,
// frozen at process time (same freeze-at-computation spirit as
// SalaryStructureComponent above).
model Payslip {
  id              String   @id @default(cuid())
  payrollRunId    String
  employeeId      String
  daysInMonth     Int
  lopDays         Int      @default(0)
  paidDays        Int
  grossEarnings   Decimal  @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)
  netPay          Decimal  @db.Decimal(12, 2)
  // grossEarnings + employer contributions (PF, ESI) — what the employee
  // actually costs the org, not what they take home.
  employerCost    Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  // Relative path under storage/ (see payslip-storage.ts) to the generated
  // PDF — null until the payslip-generate-and-email job (or the on-the-fly
  // fallback in the download route) has run at least once.
  pdfPath         String?
  pdfGeneratedAt  DateTime?

  payrollRun PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id])
  components PayslipComponent[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

// Line items on a payslip. `name` is copied text (frozen), not just the FK,
// so a payslip stays self-contained even if the SalaryComponent is renamed
// or deleted later — same reasoning as PayslipComponent's sibling models
// above. componentId is null for statutory items generated by the engine
// (PF/ESI/PT/TDS) that have no SalaryComponent row.
model PayslipComponent {
  id            String        @id @default(cuid())
  payslipId     String
  componentId   String?
  name          String
  componentType ComponentType
  amount        Decimal       @db.Decimal(12, 2)

  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component SalaryComponent? @relation(fields: [componentId], references: [id])

  @@index([payslipId])
}

// One row per employee per financial year (e.g. "2026-2027", Apr-Mar) — see
// financialYearFor in modules/payroll/taxSlabs.ts. Old-regime-only fields
// (section80C/section80D/hraExemption) are cleared to null when regime is
// NEW; see upsertTaxDeclaration in taxDeclaration.service.ts.
model EmployeeTaxDeclaration {
  id                     String    @id @default(cuid())
  organizationId         String
  employeeId             String
  financialYear          String
  regime                 TaxRegime @default(NEW)
  previousEmployerIncome Decimal?  @db.Decimal(12, 2)
  previousEmployerTds    Decimal?  @db.Decimal(12, 2)
  section80C             Decimal?  @db.Decimal(12, 2)
  section80D             Decimal?  @db.Decimal(12, 2)
  hraExemption           Decimal?  @db.Decimal(12, 2)
  otherDeductions        Decimal?  @db.Decimal(12, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, financialYear])
  @@index([organizationId])
}
